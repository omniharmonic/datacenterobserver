# Optional — set to use Mapbox tiles. If unset, the app falls back to free MapLibre demo tiles.
NEXT_PUBLIC_MAPBOX_TOKEN=

# Optional — Supabase. When set, lib/data/source.ts will use Supabase instead of the local seed JSON.
# NEXT_PUBLIC_SUPABASE_URL=
# NEXT_PUBLIC_SUPABASE_ANON_KEY=
# SUPABASE_SERVICE_ROLE_KEY=

# Optional — Geocodio for federal/state officials lookup
# GEOCODIO_API_KEY=

# Optional — secret guarding cron endpoints
# CRON_SECRET=
